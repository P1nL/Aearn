# IDE and local tool state.
.idea/
.playwright-mcp/
.omc/
.claude/worktrees/
docs/.obsidian/

# Runtime dependencies and build outputs.
**/node_modules/
**/dist/
**/.venv/
**/target/
**/.logs/
**/.pnpm-store/

# Python and packaging caches.
# Local Python welcome cache; keep other Python/ content visible to Git.
/Python/_cache/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/*.egg-info/

# Test reports and compiler caches.
.coverage
.coverage.*
coverage.xml
**/htmlcov/
**/coverage/
**/.nyc_output/
**/.eslintcache
**/*.tsbuildinfo

# Local environment, logs, and process state.
.env
.env.*
!.env.example
*.log
*.pid

# OS files.
Thumbs.db
Desktop.ini
.DS_Store

# Local Trellis active-task artifacts; archived tasks remain versioned.
.trellis/tasks/[0-9][0-9]-*/

# Local documentation workspace state and temporary material.
docs/current/.obsidian/
docs/current/.trash/
docs/current/semi-overt/
tmp/

# Volatile local Obsidian state for the Trellis task vault.
.trellis/tasks/.obsidian/workspace*.json
.trellis/tasks/.obsidian/plugins/*/data.json
