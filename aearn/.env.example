APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8001

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres?sslmode=disable
REDIS_URL=redis://127.0.0.1:6379/0

LLM_TYPE=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=60
# DeepSeek V4 Flash Responses limits. The context window is 1M tokens and the
# maximum generated output is 384K tokens; Tutor reserves output capacity from
# that window instead of broadening its allowlisted history sources.
TUTOR_DEEPSEEK_V4_FLASH_CONTEXT_WINDOW_TOKENS=1000000
TUTOR_DEEPSEEK_V4_FLASH_MAX_OUTPUT_TOKENS=384000
TUTOR_EXECUTOR_ENABLED=false
# Verified users receive at most one learner-safe activity/inbox suggestion per day.
# Curation and learner-code execution remain disabled by default.
TUTOR_PROACTIVE_SCHEDULER_ENABLED=true
TUTOR_BACKGROUND_HARD_PAUSED=false
TUTOR_PROACTIVE_CUTOVER_ELIGIBLE=true
TUTOR_PROACTIVE_DAILY_BUDGET=1
TUTOR_PROACTIVE_CONCURRENCY_LIMIT=1
TUTOR_INFERRED_MEMORY_ENABLED=false
TUTOR_CURATION_DAILY_BUDGET=0
TUTOR_CURATION_CONCURRENCY_LIMIT=1
TUTOR_CURATION_MAX_OUTPUT_TOKENS=0

TZ=Asia/Shanghai
FSRS_SCHEDULER_VERSION=fsrs_v1_default
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

RUNNER_BROWSER_ENABLED=true
RUNNER_PYTHON_ENABLED=true
RUNNER_COMPILED_SANDBOX_ENABLED=false
